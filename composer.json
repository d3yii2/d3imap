{
    "name": "d3yii2/d3imap",
    "minimum-stability": "dev",
    "prefer-stable": "true",
    "description": "yii2 extension to read and process mails from IMAP with PHP-IMAP wrapper",
    "keywords": ["yii2", "extension", "widget", "imap", "cron", "mail", "inbox"],
    "homepage": "https://github.com/yiioverflow/yii2-imap.git",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "authors": [
        {
        }
    ],
    "require": {
        "php": ">=8.4",
        "webklex/php-imap": "*"
    },
    "autoload": {
        "psr-4": {
            "d3yii2\\d3imap\\": "src/"
        }
    }
}
